<?xml version="1.0" encoding="UTF-8"?>
<decorators defaultdir="/decorators">

    <!-- Any urls that are excluded will never be decorated by Sitemesh -->
    <excludes>
        <pattern>/account/login</pattern>
    </excludes>
    <!-- apply Sitemesh default template -->
    <decorator name="admin" page="admin.jsp">
        <pattern>/admin*</pattern>
        <pattern>/staff*</pattern>
    </decorator>
<!--    <decorator name="home" page="home.jsp">-->
<!--        <pattern>/*</pattern>-->
<!--    </decorator>-->
    <decorator name="technical" page="technical-layout.jsp">
        <pattern>/technical*</pattern>
    </decorator>

    <decorator name="manager-layout" page="manager.jsp">
        <pattern>/manager*</pattern>
    </decorator>
    <decorator name="it" page="it.jsp">
        <pattern>/it*</pattern>
    </decorator>
</decorators>
